
CREATE DATABASE IF NOT EXISTS db_ecommerce;
USE db_ecommerce;

-- 1. Tabel admin
CREATE TABLE admin (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- 2. Tabel kategori
CREATE TABLE kategori (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama_kategori VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- 3. Tabel produk
CREATE TABLE produk (
    id INT AUTO_INCREMENT PRIMARY KEY,
    kategori_id INT,
    nama_produk VARCHAR(150) NOT NULL,
    deskripsi TEXT,
    harga DECIMAL(12,2) NOT NULL DEFAULT 0,
    stok INT NOT NULL DEFAULT 0,
    foto VARCHAR(255),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (kategori_id) REFERENCES kategori(id)
        ON UPDATE CASCADE ON DELETE SET NULL
) ENGINE=InnoDB;

-- 4. Tabel pelanggan
CREATE TABLE pelanggan (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    no_hp VARCHAR(20),
    alamat TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- 5. Tabel keranjang
CREATE TABLE keranjang (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pelanggan_id INT NOT NULL,
    produk_id INT NOT NULL,
    jumlah INT NOT NULL DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (pelanggan_id) REFERENCES pelanggan(id)
        ON DELETE CASCADE,
    FOREIGN KEY (produk_id) REFERENCES produk(id)
        ON DELETE CASCADE,
    UNIQUE (pelanggan_id, produk_id)
) ENGINE=InnoDB;

-- 6. Tabel pesanan
CREATE TABLE pesanan (
    id INT AUTO_INCREMENT PRIMARY KEY,
    kode_pesanan VARCHAR(30) NOT NULL UNIQUE,
    pelanggan_id INT NOT NULL,
    tanggal_pesanan TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    total_harga DECIMAL(12,2) NOT NULL DEFAULT 0,
    status ENUM('Menunggu','Diproses','Dikirim','Selesai','Dibatalkan')
        DEFAULT 'Menunggu',
    alamat_pengiriman TEXT NOT NULL,
    FOREIGN KEY (pelanggan_id) REFERENCES pelanggan(id)
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- 7. Tabel detail pesanan
CREATE TABLE detail_pesanan (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pesanan_id INT NOT NULL,
    produk_id INT NOT NULL,
    jumlah INT NOT NULL,
    harga DECIMAL(12,2) NOT NULL,
    subtotal DECIMAL(12,2) NOT NULL,
    FOREIGN KEY (pesanan_id) REFERENCES pesanan(id)
        ON DELETE CASCADE,
    FOREIGN KEY (produk_id) REFERENCES produk(id)
) ENGINE=InnoDB;

-- 8. Tabel pembayaran
CREATE TABLE pembayaran (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pesanan_id INT NOT NULL,
    metode_pembayaran VARCHAR(50),
    tanggal_pembayaran TIMESTAMP NULL,
    jumlah_bayar DECIMAL(12,2) NOT NULL DEFAULT 0,
    status ENUM('Belum Dibayar','Menunggu Verifikasi','Dibayar','Ditolak')
        DEFAULT 'Belum Dibayar',
    bukti_pembayaran VARCHAR(255),
    FOREIGN KEY (pesanan_id) REFERENCES pesanan(id)
        ON DELETE CASCADE
) ENGINE=InnoDB;

-- 9. Tabel pengiriman
CREATE TABLE pengiriman (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pesanan_id INT NOT NULL,
    kurir VARCHAR(100),
    nomor_resi VARCHAR(100),
    tanggal_kirim TIMESTAMP NULL,
    status_pengiriman ENUM('Belum Dikirim','Dalam Perjalanan','Diterima')
        DEFAULT 'Belum Dikirim',
    FOREIGN KEY (pesanan_id) REFERENCES pesanan(id)
        ON DELETE CASCADE
) ENGINE=InnoDB;

